# ---- Sponsor API keys ----
ASI_ONE_API_KEY=            # https://asi1.ai/dashboard/api-keys
ANTHROPIC_API_KEY=          # Claude (FormReader, Interpreter, Review)
DEEPGRAM_API_KEY=           # Dialogue (voice TTS/STT)
REDIS_URL=                  # redis://default:pass@host:port  (Redis Cloud free tier)
# Optional — autonomous draft mode (types into the live web form, stops before submit):
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BENEFITS_FORM_URL=          # real gov form OR your local replica

# ---- Agent seeds (any stable string; determines the agent's address) ----
ORCH_SEED=tribunal-orchestrator-seed-CHANGE-ME
FORMREADER_SEED=tribunal-formreader-seed-CHANGE-ME
DIALOGUE_SEED=tribunal-dialogue-seed-CHANGE-ME
INTERPRETER_SEED=tribunal-interpreter-seed-CHANGE-ME
REVIEW_SEED=tribunal-review-seed-CHANGE-ME
POLICY_RAG_SEED=tribunal-policy-rag-seed-CHANGE-ME

# ---- Agent addresses (fill in AFTER first boot; each agent prints its address) ----
# Orchestrator needs the four it delegates to:
FORMREADER_ADDRESS=
DIALOGUE_ADDRESS=
INTERPRETER_ADDRESS=
REVIEW_ADDRESS=
# Interpreter needs PolicyRAG for grounding:
POLICY_RAG_ADDRESS=
# The client needs the orchestrator:
ORCHESTRATOR_ADDRESS=
